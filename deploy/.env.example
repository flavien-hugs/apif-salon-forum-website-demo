# deploy/.env — copier en `deploy/.env` (non versionné).
# [OBLIGATOIRE] Hostnames publics (enregistrements DNS vers le serveur).
SALON_HOSTNAME=salon-fintech.bedet.ci
FORUM_HOSTNAME=apif.bedet.ci
# [OBLIGATOIRE] E-mail Let's Encrypt (acme-companion).
LETSENCRYPT_EMAIL=
# [OPTIONNEL] Images à déployer (défaut : dernière publication sur main).
SALON_IMAGE=ghcr.io/flavien-hugs/apif-salon-forum-website-demo/salon-fintech:latest
FORUM_IMAGE=ghcr.io/flavien-hugs/apif-salon-forum-website-demo/forum-fintech:latest
# [OPTIONNEL] Réseau Docker du companion nginx-proxy (doit exister).
PROXY_NETWORK_NAME=nginx-proxy
