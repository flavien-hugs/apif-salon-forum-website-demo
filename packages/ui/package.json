{
	"name": "@apif/ui",
	"version": "0.1.0",
	"private": true,
	"description": "Design system et composants partagés des sites publics APIF CI (Salon Fintech, espace collaboratif)",
	"type": "module",
	"svelte": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"svelte": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./theme.css": "./src/styles/theme.css",
		"./assets/*": "./src/assets/*",
		"./components/*": "./src/components/*"
	},
	"scripts": {
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run"
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"dependencies": {
		"@fontsource-variable/manrope": "^5.3.0",
		"@fontsource-variable/public-sans": "^5.3.0",
		"@lucide/svelte": "^1.58.0"
	},
	"devDependencies": {
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"svelte": "^5.57.1",
		"vite": "^8.3.0"
	}
}
